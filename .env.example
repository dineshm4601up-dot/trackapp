# Copy to .env.local and fill in values. Never commit .env.local.
# Values come from Supabase Dashboard → Project Settings → API Keys.

# ── Browser-safe (inlined into client JavaScript at build time) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). A legacy "anon" key also works here.
# Safe to expose: all data access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Maps JavaScript API key — restrict it by HTTP referrer in the provider console.
# Not used until the maps phase; may be left empty.
NEXT_PUBLIC_MAPS_API_KEY=
# Public base URL of the app (used for auth redirects in later phases).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-only (NEVER prefix with NEXT_PUBLIC_, never import in client code) ─
# Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
# Not read by the app yet; required from the agent-provisioning phase onward.
SUPABASE_SECRET_KEY=

# ── Local tooling only (never set in Vercel) ───────────────────────────────
# Postgres connection string for applying migrations from your machine
# (Dashboard → Connect). URL-encode special characters in the password
# (e.g. "@" → %40).
SUPABASE_DB_URL=
